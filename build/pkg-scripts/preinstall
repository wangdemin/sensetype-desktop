#!/bin/bash
set -euo pipefail

# preinstall runs as root via macOS Installer (user enters admin password).
# Goal:
# - Best-effort quit the running app so the bundle can be overwritten cleanly.
# - Log actions for troubleshooting.

LOG_FILE="/var/log/sensetype-install.log"
APP_NAME="Sensetype"
APP_PATH="/Applications/Sensetype.app"
MARKER_PATH="/var/tmp/sensetype-installing"

log() {
  /bin/echo "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] $*" | /usr/bin/tee -a "$LOG_FILE" >/dev/null
}

main() {
  log "preinstall start (uid=$(id -u), user=$(id -un 2>/dev/null || echo unknown))"

  # Mark installation in progress so the app can delay startup work if it is auto-launched.
  /usr/bin/touch "$MARKER_PATH" >>"$LOG_FILE" 2>&1 || true
  log "install marker set: ${MARKER_PATH}"

  # Try graceful quit via AppleScript (works if app has UI + running under a user session)
  if /usr/bin/osascript -e "tell application \"${APP_NAME}\" to if it is running then quit" >>"$LOG_FILE" 2>&1; then
    log "osascript quit attempted for ${APP_NAME}"
  else
    log "WARN: osascript quit failed (continuing)"
  fi

  # Give the app time to exit gracefully (especially important for Intel Macs where permission checks may block)
  /bin/sleep 2

  # Check if app is still running and force terminate if needed
  local max_attempts=5
  local attempt=0
  while [ $attempt -lt $max_attempts ]; do
    if ! /usr/bin/pgrep -x "${APP_NAME}" >/dev/null 2>&1; then
      log "${APP_NAME} successfully quit (attempt $((attempt + 1)))"
      break
    fi

    attempt=$((attempt + 1))
    if [ $attempt -eq 1 ]; then
      # First attempt: try SIGTERM (graceful)
      log "attempting graceful termination (SIGTERM) for ${APP_NAME} (attempt $attempt)"
      /usr/bin/pkill -x "${APP_NAME}" >>"$LOG_FILE" 2>&1 || true
    else
      # Subsequent attempts: try SIGKILL (force)
      log "attempting force termination (SIGKILL) for ${APP_NAME} (attempt $attempt)"
      /usr/bin/pkill -9 -x "${APP_NAME}" >>"$LOG_FILE" 2>&1 || true
    fi

    # Wait a bit before checking again
    /bin/sleep 1
  done

  # Final check: if still running, log warning but continue (installer will handle it)
  if /usr/bin/pgrep -x "${APP_NAME}" >/dev/null 2>&1; then
    log "WARN: ${APP_NAME} still running after $max_attempts attempts (continuing anyway)"
  fi

  # Additional wait to ensure all file handles are released (especially native modules)
  /bin/sleep 1

  # Ensure old bundle is removed to avoid leftover binaries (which can cause signature mismatch and weird permission behavior).
  # macOS Installer environment typically does NOT have GNU `timeout` (and PATH may not include Homebrew),
  # so we implement a small timeout in bash to avoid hanging.
  rm_with_timeout() {
    local target="$1"
    local max_seconds="$2"

    /bin/rm -rf "$target" >>"$LOG_FILE" 2>&1 &
    local pid=$!
    local elapsed=0

    while /bin/kill -0 "$pid" >/dev/null 2>&1; do
      if [ "$elapsed" -ge "$max_seconds" ]; then
        log "WARN: rm -rf timed out after ${max_seconds}s (pid=$pid), killing..."
        /bin/kill -9 "$pid" >>"$LOG_FILE" 2>&1 || true
        break
      fi
      /bin/sleep 1
      elapsed=$((elapsed + 1))
    done

    /bin/wait "$pid" >>"$LOG_FILE" 2>&1 || true
  }

  if [ -d "$APP_PATH" ]; then
    log "removing existing app bundle: ${APP_PATH}"
    rm_with_timeout "$APP_PATH" 10
    if [ -d "$APP_PATH" ]; then
      log "WARN: bundle still exists after removal attempt: ${APP_PATH}"
    else
      log "removed: ${APP_PATH}"
    fi
  fi

  log "preinstall done"
}

main "$@"
